FROM alpine/git:2.52.0 AS clone

RUN mkdir /app && \
    cd /app && \
    git clone --depth 1 --revision b61146faa7c38bd4380837f4fda9266b766a2411 https://github.com/Vul-Detection-MCP/codebadger.git .

FROM python:3.13.3 AS build

COPY --from=clone /app/ /app/

RUN cd /app && pip install -r requirements.txt

CMD ["python", "/app/main.py"]
